{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex.invalid/3d-deep-research/research-state.schema.json",
  "title": "3d-deep-research structured research state",
  "description": "立体分析研究通过证据门控后的可选机器可读状态。SKILL.md 是流程真相源，本 Schema 只约束结构化状态。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "search_questions",
    "sources",
    "claims",
    "analysis",
    "future",
    "visuals"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "search_questions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "causes_and_mechanisms",
        "counterevidence"
      ],
      "properties": {
        "facts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "causes_and_mechanisms": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "counterevidence": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_axis",
        "y_axis",
        "z_axis",
        "synthesis"
      ],
      "properties": {
        "x_axis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "narrative",
            "turning_points"
          ],
          "properties": {
            "narrative": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "turning_points": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/turningPoint"
              }
            }
          }
        },
        "y_axis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/forceField"
          }
        },
        "z_axis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/mechanism"
          }
        },
        "synthesis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/insight"
          }
        }
      }
    },
    "future": {
      "$ref": "#/$defs/future"
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "default": []
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "sourceId": {
      "type": "string",
      "pattern": "^S[0-9]{2,}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^C[0-9]{2,}$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "subject_type",
        "research_question",
        "started_on",
        "time_baseline",
        "scope"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subject_type": {
          "enum": [
            "product",
            "company",
            "technology",
            "concept",
            "person",
            "event",
            "industry",
            "other"
          ]
        },
        "research_question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "motivation": {
          "type": "string"
        },
        "focus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "started_on": {
          "type": "string",
          "format": "date"
        },
        "time_baseline": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "location",
        "accessed_on",
        "provenance",
        "evidence_roles",
        "independence",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "publisher": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        },
        "provenance": {
          "enum": [
            "primary",
            "independent-secondary",
            "community",
            "lead-only"
          ]
        },
        "evidence_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "fact",
              "behavior",
              "context",
              "user-voice",
              "counterevidence"
            ]
          }
        },
        "independence": {
          "enum": [
            "independent",
            "shared-origin",
            "unknown"
          ]
        },
        "limitations": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "claim_type",
        "importance",
        "supporting_source_ids",
        "counterevidence",
        "independence",
        "confidence",
        "evidence_gap",
        "disconfirmation_condition"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claimId"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_type": {
          "enum": [
            "fact",
            "causal",
            "mechanism",
            "market",
            "forecast"
          ]
        },
        "importance": {
          "enum": [
            "load-bearing",
            "supporting"
          ]
        },
        "supporting_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "counterevidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_ids",
            "search_note"
          ],
          "properties": {
            "source_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceId"
              }
            },
            "search_note": {
              "type": "string"
            }
          }
        },
        "independence": {
          "enum": [
            "independent",
            "shared-origin",
            "mixed",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence_gap": {
          "type": "string"
        },
        "disconfirmation_condition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stale_after": {
          "type": "string",
          "format": "date",
          "description": "Evidence staleness horizon by claim type; claims past this date must be revisited."
        },
        "revisit_status": {
          "enum": [
            "not-due",
            "due",
            "revisited-holds",
            "overturned",
            "partially-revised"
          ],
          "description": "Claim lifecycle status recorded on each revisit."
        }
      }
    },
    "turningPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "event",
        "why_it_happened",
        "why_it_mattered",
        "transition_mechanism",
        "claim_ids"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "event": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "why_it_happened": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "why_it_mattered": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "transition_mechanism": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimId"
          }
        }
      }
    },
    "forceField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_slice",
        "central_tension",
        "forces",
        "interactions",
        "agency",
        "overlooked_variable",
        "path_effect",
        "claim_ids"
      ],
      "properties": {
        "time_slice": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "central_tension": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "forces": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "interactions": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "agency": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "overlooked_variable": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path_effect": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimId"
          }
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "internal_structure",
        "motivation",
        "constraints",
        "interactions",
        "alternative_explanation",
        "explanatory_gain",
        "claim_ids"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "internal_structure": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "motivation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "constraints": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "interactions": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "alternative_explanation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "explanatory_gain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimId"
          }
        }
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "insight",
        "x_basis",
        "y_basis",
        "z_basis",
        "alternative_explanation",
        "confidence",
        "disconfirmation_condition"
      ],
      "properties": {
        "insight": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "x_basis": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "y_basis": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "z_basis": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "alternative_explanation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "disconfirmation_condition": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "future": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "drivers",
        "baseline",
        "leading_indicators",
        "alternative_explanation",
        "disconfirmation_condition"
      ],
      "properties": {
        "mode": {
          "enum": [
            "baseline",
            "scenario-matrix",
            "indicators-only"
          ]
        },
        "drivers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "impact",
              "uncertainty"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "impact": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "uncertainty": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "baseline": {
          "type": "string"
        },
        "scenario_axes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "leading_indicators": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "alternative_explanation": {
          "type": "string"
        },
        "disconfirmation_condition": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "scenario-matrix"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "scenario_axes"
            ],
            "properties": {
              "scenario_axes": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "baseline"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "baseline": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure_id",
        "title",
        "visual_type",
        "chart_kind",
        "question_type",
        "question_answered",
        "source_ids",
        "uncertainty"
      ],
      "properties": {
        "figure_id": {
          "type": "string",
          "pattern": "^F[0-9]{2,}$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "visual_type": {
          "enum": [
            "timeline",
            "force-field",
            "mechanism",
            "matrix",
            "evidence",
            "scenario",
            "xyz-synthesis",
            "other"
          ]
        },
        "chart_kind": {
          "enum": [
            "data",
            "structural"
          ],
          "description": "数据图或结构图，按 chart-allocation.md 的 F/R/M 决策层规则确定。"
        },
        "question_type": {
          "enum": [
            "F",
            "R",
            "M"
          ],
          "description": "该图回答的问题类型：F 定量事实型 / R 关系机制型 / M 混合判断型。"
        },
        "paired_with": {
          "type": "string",
          "pattern": "^F[0-9]{2,}$",
          "description": "M 型问题的配对图编号（数据锚 ↔ 结构解），可选。"
        },
        "question_answered": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "uncertainty": {
          "type": "string"
        }
      }
    }
  }
}
