{
  "name": "jeffy-design",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Content-first presentation design with reusable materials, themes, composition and validation.",
  "scripts": {
    "test": "node scripts/sync.mjs --check && node scripts/test-theme-contract.mjs",
    "catalog": "python scripts/build-catalog.py",
    "example:pressure": "node scripts/build-composition.mjs tests/composition/pressure.json build/pressure/index.html",
    "example:extended": "node scripts/build-composition.mjs tests/composition/extended.json build/extended/index.html",
    "verify:pressure": "node scripts/verify-page.mjs build/pressure/index.html build/pressure/validation.json",
    "verify:extended": "node scripts/verify-page.mjs build/extended/index.html build/extended/validation.json",
    "test:composition": "node scripts/test-composition.mjs build/reports/composition.json",
    "test:adapters": "node scripts/test-composition-extended.mjs build/reports/adapters.json",
    "test:themes": "node scripts/test-themes.mjs build/theming",
    "format": "prettier --write \"lib/**/*.{js,mjs}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"lib/**/*.{js,mjs}\" \"scripts/*.mjs\"",
    "outline": "node scripts/validate-outline.mjs",
    "notes": "node scripts/check-notes.mjs",
    "embed": "node scripts/embed-fonts.mjs",
    "fonts": "bash scripts/install-fonts.sh",
    "pack": "bash scripts/pack-skill.sh",
    "font-metrics": "/opt/data/venvs/fonts/bin/python scripts/font-metrics.py",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "test:materials": "node scripts/test-material-contract.mjs",
    "test:all": "npm run test && npm run test:composition && npm run test:adapters && npm run test:themes && npm run test:materials",
    "specimen": "node scripts/build-specimen.mjs",
    "baseline": "node scripts/visual-baseline.mjs",
    "baseline:update": "node scripts/visual-baseline.mjs --update",
    "gen:rules": "node scripts/gen-rules.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=18"
  }
}
