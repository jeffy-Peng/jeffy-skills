{
  "name": "jeffy-design",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Content-first presentation design with reusable materials, themes, composition and validation.",
  "scripts": {
    "test": "node scripts/test-theme-contract.mjs",
    "catalog": "python scripts/build-catalog.py",
    "example:pressure": "node scripts/build-composition.mjs tests/composition/pressure.json build/pressure/index.html",
    "example:extended": "node scripts/build-composition.mjs tests/composition/extended.json build/extended/index.html",
    "verify:pressure": "node scripts/verify-page.mjs build/pressure/index.html build/pressure/validation.json",
    "verify:extended": "node scripts/verify-page.mjs build/extended/index.html build/extended/validation.json",
    "test:composition": "node scripts/test-composition.mjs build/reports/composition.json",
    "test:adapters": "node scripts/test-composition-extended.mjs build/reports/adapters.json",
    "test:themes": "node scripts/test-themes.mjs build/theming"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}
