  "usage": {
    "scenarios": "产品发布、品牌提案、技术与设计评审",
    "audience": "需要轻盈质感但仍要读清数据的决策者",
    "note": "玻璃质感优先看层次，数据文字必须保持对比度。"
  },
  "page": {
    "canvas": {
      "width": 1280,
      "height": 720
    },
    "title": {
      "x": 64,
      "y": 34,
      "width": 1152,
      "height": 70
