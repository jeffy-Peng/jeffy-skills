{
  "version": "0.3.0",
  "canvas": [
    1280,
    720
  ],
  "geometry": {
    "marginX": 44,
    "contentWidth": 1192,
    "kickerTop": 18,
    "titleTop": 30,
    "ruleTop": 104,
    "contentTop": 118,
    "footerTop": 682,
    "cardGap": 16,
    "cardPadding": 24
  },
  "type": {
    "title": {
      "size": 28,
      "lineHeight": 1.24,
      "weight": 700
    },
    "bandTitle": {
      "size": 15,
      "lineHeight": 1.3,
      "weight": 600
    },
    "cardTitle": {
      "size": 15,
      "lineHeight": 1.3,
      "weight": 600
    },
    "body": {
      "size": 13,
      "lineHeight": 1.65
    },
    "meta": {
      "size": 12,
      "lineHeight": 1.5
    },
    "note": {
      "size": 11,
      "lineHeight": 1.6
    },
    "footer": {
      "size": 10.5,
      "lineHeight": 1
    }
  },
  "limits": {
    "pages": [
      12,
      16
    ],
    "titleChars": [
      12,
      22
    ],
    "pageBodyChars": [
      200,
      450
    ],
    "accentPerPage": 2,
    "structuralAccent": "标题、带标题、编号这类结构性红色不算进 accentPerPage",
    "sources": 24,
    "themes": 5
  },
  "banned": [
    {
      "pattern": "box-shadow",
      "why": "阴影会把页面拉回公众号模板"
    },
    {
      "pattern": "linear-gradient",
      "why": "渐变不在配色系统里"
    },
    {
      "pattern": "border-radius",
      "why": "圆角没有统一半径，不如全部直角"
    },
    {
      "pattern": "url(http",
      "why": "单文件交付，不能有网络请求"
    },
    {
      "pattern": "@keyframes",
      "why": "动画在可转换性里是禁止项"
    }
  ],
  "targets": {
    "density": "单页正文 200 到 450 字，中位数 300 左右",
    "accent": "语义标红（正文里的关键词）每页不超过 2 处",
    "titles": "标题串连起来能读完整个故事"
  },
  "titleRules": {
    "note": "标题是排版参考，不强制每页下结论。判断是否合格靠回查，不靠词表。",
    "lengthHint": [
      10,
      24
    ],
    "hardMax": 26,
    "types": [
      "总览",
      "比较",
      "流程",
      "分析"
    ],
    "forbidden": {
      "dash": "破折号和连接号",
      "colon": "提示性冒号（引出人物原话除外）",
      "jargon": [
        "赋能",
        "抓手",
        "闭环",
        "底层逻辑",
        "降本增效",
        "全链路"
      ],
      "signpost": [
        "说白了",
        "说穿了",
        "先说结论",
        "值得注意的是",
        "更微妙的是",
        "从某种意义上说"
      ],
      "empty": [
        "浅析",
        "探讨",
        "研究现状"
      ]
    },
    "check": "遮住正文只看标题：能说出对象吗；判断能指回证据吗；去掉数字、比喻、对仗还剩什么"
  }
}
