{
  "version": 5,
  "note": "素材共用规则。规则正文见 docs/素材规则.md，这里只留机器可读的编号、分组、错误码与落地状态。哪些规则所有素材共用，以这份为准。",
  "principles": [
    "宁可报错，不许悄悄改数据",
    "不缩字号、不补零、不去重、不截断、不省标签"
  ],
  "limits": {
    "minBarThicknessPx": 8,
    "minRowHeightPx": 22,
    "minPointGapPx": 16,
    "minTableRowPx": 24,
    "maxCategories": 12,
    "maxPoints": 24,
    "maxTableRows": 12,
    "maxNodes": 40
  },
  "rules": [
    {
      "id": "R1",
      "group": "input",
      "rule": "条目必须有 label 与 value 或 values",
      "code": "DATA",
      "status": "partial"
    },
    {
      "id": "R2",
      "group": "input",
      "rule": "数据数组不能为空",
      "code": "DATA",
      "status": "partial"
    },
    {
      "id": "R3",
      "group": "input",
      "rule": "缺失值报错，不补零不跳过",
      "code": "DATA",
      "status": "missing"
    },
    {
      "id": "R4",
      "group": "input",
      "rule": "值必须是有限数字",
      "code": "DATA",
      "status": "partial"
    },
    {
      "id": "R5",
      "group": "input",
      "rule": "负值允许，百分比模式禁止负值",
      "code": "DATA",
      "status": "partial"
    },
    {
      "id": "R6",
      "group": "input",
      "rule": "全零允许，百分比显示无占比",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R7",
      "group": "input",
      "rule": "单条数据允许并保留轴与刻度",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R8",
      "group": "input",
      "rule": "重复类别名报错，不自动去重",
      "code": "DATA",
      "status": "missing"
    },
    {
      "id": "R9",
      "group": "input",
      "rule": "数字显示：一万用万、一亿用亿，单位已含时不换算",
      "code": "none",
      "status": "missing"
    },
    {
      "id": "R10",
      "group": "input",
      "rule": "单位只标一次，值标签不带单位，百分比分母为类别合计",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R11",
      "group": "input",
      "rule": "超过数量上限报容量并建议分页",
      "code": "CAPACITY",
      "status": "partial"
    },
    {
      "id": "R12",
      "group": "structure",
      "rule": "方向只对适用素材生效，不适用时报 UNSUPPORTED",
      "code": "UNSUPPORTED",
      "status": "enforced"
    },
    {
      "id": "R13",
      "group": "structure",
      "rule": "排序取 given、desc、asc，只改顺序不改数据",
      "code": "none",
      "status": "missing"
    },
    {
      "id": "R14",
      "group": "structure",
      "rule": "mode 与 kind 的组合必须合法",
      "code": "UNSUPPORTED",
      "status": "partial"
    },
    {
      "id": "R15",
      "group": "structure",
      "rule": "图例顺序等于绘制顺序等于 series 顺序",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R16",
      "group": "visual",
      "rule": "字号字重行高颜色只能取主题角色",
      "code": "THEME",
      "status": "enforced"
    },
    {
      "id": "R17",
      "group": "visual",
      "rule": "间距圆角线宽柱形来自主题参数",
      "code": "THEME",
      "status": "enforced"
    },
    {
      "id": "R18",
      "group": "visual",
      "rule": "笔触由主题按族指定",
      "code": "THEME",
      "status": "enforced"
    },
    {
      "id": "R19",
      "group": "visual",
      "rule": "字体来自主题，缺失报错不静默回退",
      "code": "FONT",
      "status": "enforced"
    },
    {
      "id": "R20",
      "group": "output",
      "rule": "放不下报容量并附 required 与 actual",
      "code": "CAPACITY",
      "status": "partial"
    },
    {
      "id": "R21",
      "group": "output",
      "rule": "任何省略合并截断都必须报错",
      "code": "CAPACITY",
      "status": "partial"
    },
    {
      "id": "R22",
      "group": "output",
      "rule": "低于最小可读尺寸报容量",
      "code": "CAPACITY",
      "status": "partial"
    },
    {
      "id": "R23",
      "group": "output",
      "rule": "文字节点回报位置尺寸与字号",
      "code": "none",
      "status": "enforced"
    },
    {
      "id": "R24",
      "group": "output",
      "rule": "图表根节点带 role 与 aria-label",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R25",
      "group": "trace",
      "rule": "保留素材 ID 与实现版本，验收记录绑定输入",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R26",
      "group": "legend",
      "rule": "图例底部居中，不足换行，两行仍不足报容量",
      "code": "CAPACITY",
      "status": "partial"
    },
    {
      "id": "R27",
      "group": "legend",
      "rule": "图例符号与图形一致",
      "code": "THEME",
      "status": "missing"
    },
    {
      "id": "R28",
      "group": "legend",
      "rule": "图例项数等于系列数，单系列可省略",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R29",
      "group": "legend",
      "rule": "系列名不截断，超宽换行，两行不足报容量",
      "code": "CAPACITY",
      "status": "partial"
    },
    {
      "id": "R30",
      "group": "legend",
      "rule": "图例不写单位，单位只在轴端一次",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R31",
      "group": "legend",
      "rule": "只保留一套图例实现，特殊位置通过参数传",
      "code": "none",
      "status": "missing"
    },
    {
      "id": "R32",
      "group": "structure",
      "rule": "提纲必须声明交付形式（chart、deck、report），未声明按 chart 处理",
      "code": "CONTENT",
      "status": "missing"
    },
    {
      "id": "R33",
      "group": "structure",
      "rule": "组件必须写明选型理由；用后备或仅规范素材时必须点名主力为何不适配",
      "code": "CONTENT",
      "status": "missing"
    },
    {
      "id": "R34",
      "group": "input",
      "rule": "刻度步长只能取 1、2、2.5、5、10 的十进制倍数",
      "code": "none",
      "status": "enforced"
    },
    {
      "id": "R35",
      "group": "visual",
      "rule": "线宽按角色分：轴 1.3px，网格 1px，不互相比较",
      "code": "THEME",
      "status": "enforced"
    },
    {
      "id": "R36",
      "group": "input",
      "rule": "单位用数据真实单位，不换算、不省略",
      "code": "none",
      "status": "partial"
    },
    {
      "id": "R37",
      "group": "visual",
      "rule": "一份交付只锁一套色彩系统，不混主题",
      "code": "THEME",
      "status": "partial"
    },
    {
      "id": "R38",
      "group": "layout",
      "rule": "纵向位置与高度取 8px 基线；横向 4 栏、栏距 24，组件默认占满，可声明 span 1 到 4",
      "code": "CONTRACT",
      "status": "partial"
    },
    {
      "id": "R39",
      "group": "layout",
      "rule": "间距只用 8、16、24 三档：标题到分隔线 8，分隔线到内容 16，块间 24，内容底到页脚 16",
      "code": "THEME",
      "status": "partial"
    },
    {
      "id": "R40",
      "group": "layout",
      "rule": "密度上限：稀疏 1 个组件，常规 2 个，密集 3 个；超出报容量，密度不限制占用比例",
      "code": "CAPACITY",
      "status": "enforced"
    },
    {
      "id": "R41",
      "group": "layout",
      "rule": "结论行按实测文字宽度计算行数，高度向上取整到 8px，页面不得手写高度",
      "code": "CONTENT",
      "status": "enforced"
    },
    {
      "id": "R42",
      "group": "visual",
      "rule": "柱宽取槽位比例，默认 0.5，夹取 8px 到槽位八成，不设固定像素上限",
      "code": "CAPACITY",
      "status": "enforced"
    }
  ],
  "errorCodes": {
    "DATA": "数据不合法",
    "CAPACITY": "空间不足",
    "LAYOUT": "元素碰撞或越界",
    "THEME": "主题配置或角色不符",
    "FONT": "字体缺失或被替换",
    "UNSUPPORTED": "当前实现不支持该表达或选项",
    "CONTRACT": "结构错误",
    "CONTENT": "缺问题、结论、讲稿或来源"
  },
  "deliverables": [
    "chart",
    "deck",
    "report"
  ],
  "grid": {
    "baselinePx": 8,
    "columns": 4,
    "gutterPx": 24,
    "spacing": [
      8,
      16,
      24
    ]
  }
}
