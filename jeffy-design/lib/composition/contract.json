{
  "version": 7,
  "note": "共同语义与验收目标；checked 仅指现有代表测试，不表示任意输入均自动覆盖。视觉数值以主题为准，具体接口见素材规范。",
  "principles": [
    "宁可报错，不许悄悄改数据",
    "不缩字号、不补零、不去重、不截断、不省标签"
  ],
  "limits": {
    "minBarThicknessPx": 8,
    "minRowHeightPx": 22,
    "minPointGapPx": 16,
    "minTableRowPx": 24
  },
  "rules": [
    {
      "id": "R1",
      "group": "input",
      "rule": "数值类条目按所选素材提供类别及数值；其他素材按其输入契约",
      "code": "DATA",
      "checked": true
    },
    {
      "id": "R2",
      "group": "input",
      "rule": "数据数组不能为空",
      "code": "DATA",
      "checked": true
    },
    {
      "id": "R3",
      "group": "input",
      "rule": "缺失值报错，不补零不跳过",
      "code": "DATA"
    },
    {
      "id": "R4",
      "group": "input",
      "rule": "值必须是有限数字",
      "code": "DATA",
      "checked": true
    },
    {
      "id": "R5",
      "group": "input",
      "rule": "负值仅用于允许负数的素材；占比和非负量禁止负值",
      "code": "DATA",
      "checked": true
    },
    {
      "id": "R6",
      "group": "input",
      "rule": "全零允许，百分比显示无占比",
      "code": "none",
      "checked": true
    },
    {
      "id": "R7",
      "group": "input",
      "rule": "单条数据允许；轴是否显示由主题和形态决定",
      "code": "none"
    },
    {
      "id": "R8",
      "group": "input",
      "rule": "重复类别名报错，不自动去重",
      "code": "DATA"
    },
    {
      "id": "R9",
      "group": "input",
      "rule": "按明确单位显示数值；不自动改成万或亿；必要换算须说明且同步修改单位",
      "code": "none"
    },
    {
      "id": "R10",
      "group": "input",
      "rule": "单位只标一次，值标签不带单位，百分比分母为类别合计",
      "code": "none",
      "checked": true
    },
    {
      "id": "R11",
      "group": "input",
      "rule": "按实际区域、主题字号与数据量检查容量，不设全库固定数量上限",
      "code": "CAPACITY"
    },
    {
      "id": "R12",
      "group": "structure",
      "rule": "方向只对适用素材生效，不适用时报 UNSUPPORTED",
      "code": "UNSUPPORTED"
    },
    {
      "id": "R13",
      "group": "structure",
      "rule": "排序取 given、desc、asc，只改顺序不改数据",
      "code": "none"
    },
    {
      "id": "R14",
      "group": "structure",
      "rule": "mode 与 kind 的组合必须合法",
      "code": "UNSUPPORTED"
    },
    {
      "id": "R15",
      "group": "structure",
      "rule": "图例顺序等于绘制顺序等于 series 顺序",
      "code": "none"
    },
    {
      "id": "R16",
      "group": "visual",
      "rule": "字号字重行高颜色只能取主题角色",
      "code": "THEME"
    },
    {
      "id": "R17",
      "group": "visual",
      "rule": "视觉数值来自主题；素材形态由选材步骤显式选择",
      "code": "THEME"
    },
    {
      "id": "R18",
      "group": "visual",
      "rule": "笔触声明由主题选择，当前实现能力以绘制层为准",
      "code": "THEME"
    },
    {
      "id": "R19",
      "group": "visual",
      "rule": "字体来自主题，缺失报错不静默回退",
      "code": "FONT"
    },
    {
      "id": "R20",
      "group": "output",
      "rule": "放不下明确返回 CAPACITY；required 是可用时的估计，不冒称精确最小区域",
      "code": "CAPACITY"
    },
    {
      "id": "R21",
      "group": "output",
      "rule": "任何省略合并截断都必须报错",
      "code": "CAPACITY"
    },
    {
      "id": "R22",
      "group": "output",
      "rule": "低于最小可读尺寸报容量",
      "code": "CAPACITY"
    },
    {
      "id": "R23",
      "group": "output",
      "rule": "文字节点回报位置尺寸与字号",
      "code": "none"
    },
    {
      "id": "R24",
      "group": "output",
      "rule": "图表根节点带 role 与 aria-label",
      "code": "none"
    },
    {
      "id": "R25",
      "group": "trace",
      "rule": "保留素材 ID 与实现版本，验收记录绑定输入",
      "code": "none"
    },
    {
      "id": "R26",
      "group": "legend",
      "rule": "图例底部居中，不足换行，两行仍不足报容量",
      "code": "CAPACITY",
      "checked": true
    },
    {
      "id": "R27",
      "group": "legend",
      "rule": "图例符号与图形一致",
      "code": "THEME",
      "checked": true
    },
    {
      "id": "R28",
      "group": "legend",
      "rule": "图例项数等于系列数，单系列可省略",
      "code": "none",
      "checked": true
    },
    {
      "id": "R29",
      "group": "legend",
      "rule": "系列名不截断，超宽换行，两行不足报容量",
      "code": "CAPACITY",
      "checked": true
    },
    {
      "id": "R30",
      "group": "legend",
      "rule": "图例不写单位，单位只在轴端一次",
      "code": "none",
      "checked": true
    },
    {
      "id": "R31",
      "group": "legend",
      "rule": "只保留一套图例实现，特殊位置通过参数传",
      "code": "none"
    },
    {
      "id": "R32",
      "group": "structure",
      "rule": "默认交付 deck 式 HTML 与讲稿；明确要求单图时用 chart；report 非独立报告渲染器",
      "code": "CONTENT"
    },
    {
      "id": "R33",
      "group": "structure",
      "rule": "组件用 purpose 写明区域任务与选型理由，兼容旧 reason；不强制寻找固定主力替代",
      "code": "CONTENT"
    },
    {
      "id": "R34",
      "group": "input",
      "rule": "刻度步长只能取 1、2、2.5、5、10 的十进制倍数",
      "code": "none"
    },
    {
      "id": "R35",
      "group": "visual",
      "rule": "轴、网格等线宽分别读取主题角色，不固定通用像素值",
      "code": "THEME"
    },
    {
      "id": "R36",
      "group": "input",
      "rule": "数值与单位保持一致，换算须显式说明，不丢口径",
      "code": "none"
    },
    {
      "id": "R37",
      "group": "visual",
      "rule": "一份交付只锁一套色彩系统，不混主题",
      "code": "THEME"
    },
    {
      "id": "R38",
      "group": "layout",
      "rule": "自动布局按主题基线和网格；显式区域允许自由分配，但须在可用区内并通过容量检查",
      "code": "CONTRACT",
      "checked": true
    },
    {
      "id": "R39",
      "group": "layout",
      "rule": "间距和基线读取所选主题，不在页面或素材私写另一套固定数值",
      "code": "THEME"
    },
    {
      "id": "R40",
      "group": "layout",
      "rule": "密度是布局建议，不按组件数量判错；按目标区域、实际文字和数据检查可读容量",
      "code": "CAPACITY",
      "checked": true
    },
    {
      "id": "R41",
      "group": "layout",
      "rule": "claim 是语义字段；显式显示时测量结论行占位，固定布局不得被自动结论行侵占",
      "code": "CONTENT",
      "checked": true
    },
    {
      "id": "R42",
      "group": "visual",
      "rule": "柱宽取槽位比例与主题可读下限，不设固定像素上限；槽位不足报容量",
      "code": "CAPACITY",
      "checked": true
    }
  ],
  "errorCodes": {
    "DATA": "数据不合法",
    "CAPACITY": "空间不足",
    "LAYOUT": "元素碰撞或越界",
    "THEME": "主题配置或角色不符",
    "FONT": "字体缺失或被替换",
    "UNSUPPORTED": "当前实现不支持该表达或选项",
    "CONTRACT": "结构错误",
    "CONTENT": "缺问题、结论、讲稿或来源"
  },
  "deliverables": [
    "chart",
    "deck",
    "report"
  ],
  "grid": {
    "baselinePx": 8,
    "columns": 4,
    "gutterPx": 24,
    "spacing": [
      8,
      16,
      24
    ]
  },
  "gridNote": "grid 仅为历史默认参考，执行时读取所选主题 grid。"
}
