    {
      "id": "waterfall",
      "title": "100加45减25加10，结果为130",
      "question": "多项增减如何共同形成结果？",
      "claim": "增加与减少按输入顺序累计，最终合计130万元。",
      "readingOrder": [
        "water",
        "explain"
      ],
      "components": [
        {
          "id": "water",
          "material": "BAR-006",
          "purpose": "核对正负变化与累计终点",
